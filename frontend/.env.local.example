# PartProof Frontend Environment Configuration
# Copy this file to .env.local for local development.

# Upstream FastAPI backend URL (accessed server-side by Next.js BFF)
# Default for local development with backend running locally or forwarded over SSH tunnel
PARTPROOF_API_URL=http://127.0.0.1:8000

# Next.js Application Origin (used for CSRF/Origin validation on BFF mutations)
APP_ORIGIN=http://localhost:3000

[Unit]
Description=Wait for PartProof PostgreSQL Container Health
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
TimeoutStartSec=90
ExecStart=/bin/bash -c 'for i in $(seq 1 30); do status=$(docker inspect --format "{{.State.Health.Status}}" partproof-postgres 2>/dev/null); if [ "$$status" = "healthy" ]; then exit 0; fi; echo "Waiting for partproof-postgres health (attempt $$i/30, status=$$status)..."; sleep 2; done; echo "Timed out waiting for partproof-postgres health"; exit 1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target

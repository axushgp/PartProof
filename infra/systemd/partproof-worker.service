[Unit]
Description=PartProof Background Execution Worker (Vultr Microsandbox)
After=network.target postgresql.service docker.service
Wants=postgresql.service

[Service]
Type=simple
User=linuxuser
Group=linuxuser
WorkingDirectory=/home/linuxuser/partproof/backend
EnvironmentFile=/home/linuxuser/partproof/backend/.env
ExecStart=/home/linuxuser/partproof/backend/.venv/bin/python -m app.workers.execution_worker

# Concurrency & file limits
LimitNOFILE=65536

# Graceful termination for MicroVM cleanup
KillMode=mixed
TimeoutStopSec=30
Restart=on-failure
RestartSec=5s

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=partproof-worker

[Install]
WantedBy=multi-user.target

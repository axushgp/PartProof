# PartProof Environment Configuration
# Copy this file to .env and configure values appropriately.

# Environment Mode: development | staging | production
PARTPROOF_ENV=development

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true
SECRET_KEY=change-this-in-production-use-a-secure-random-64-char-string

# Vultr Serverless Inference Configuration
# Note: Vultr Inference API Key remains strictly backend-side and is NEVER passed to sandboxes or frontend
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_MODEL=glm-5.3
VULTR_INFERENCE_FALLBACK_MODEL=glm-5.3-flash
VULTR_INFERENCE_TIMEOUT_SECONDS=60

# Sandbox Backend: "mock" (for local Windows/Mac development) | "microsandbox" (for Vultr Linux KVM host)
SANDBOX_BACKEND=mock

# Sandbox Execution Limits & Policy Defaults
SANDBOX_DEFAULT_IMAGE=python:3.12-slim
SANDBOX_MAX_CONCURRENT=1
SANDBOX_DEFAULT_TIMEOUT_SECONDS=30
SANDBOX_MAX_TIMEOUT_SECONDS=120
SANDBOX_DEFAULT_CPUS=1
SANDBOX_DEFAULT_MEMORY_MB=512
SANDBOX_DEFAULT_NETWORK=none

# Database Configuration
# Local SQLite for immediate zero-dependency testing:
DATABASE_URL=sqlite+aiosqlite:///./partproof.db
# Production PostgreSQL on Vultr VM (Docker):
# DATABASE_URL=postgresql+asyncpg://partproof:your_secure_password@localhost:5432/partproof_db

# Artifacts & Storage
ARTIFACT_STORAGE_DIR=./partproof_artifacts

# Demo Seed Credentials
DEMO_USER_EMAIL=auditor@partproof.io
DEMO_USER_PASSWORD=PartProofSecureDemo2026!

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
